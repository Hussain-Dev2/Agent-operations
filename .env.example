# ---- Hub ----
# Postgres connection (docker compose up -d starts one on localhost:5432)
DATABASE_URL=postgres://operator:operator-dev@localhost:5432/operator
POSTGRES_PASSWORD=operator-dev
# 32 random bytes, base64. Encrypts secrets at rest (hub signing key, TOTP, API keys).
# Generate: openssl rand -base64 32      Losing it makes stored secrets unreadable.
MASTER_KEY=
HUB_HOST=127.0.0.1
HUB_PORT=4000
# Origin you open in the browser. Use your https://<machine>.<tailnet>.ts.net URL for remote access.
PUBLIC_WEB_URL=http://localhost:3100
# WebSocket base URL browsers use for live updates (wss:// when PUBLIC_WEB_URL is https).
PUBLIC_WS_URL=ws://localhost:4000
# Proxies whose X-Forwarded-For is trusted (the Next.js server).
TRUST_PROXY=127.0.0.1,::1
# Optional: serve the hub itself over TLS
# TLS_CERT_FILE=/path/cert.pem
# TLS_KEY_FILE=/path/key.pem
LOG_LEVEL=info

# ---- Web ----
# Where the Next.js server proxies /api/* to.
HUB_URL=http://127.0.0.1:4000
